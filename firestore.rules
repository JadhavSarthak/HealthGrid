rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Health facility network state
    match /phcs/{phcId} {
      allow read: if true;
      allow write: if true; // Demo prototype allows situational engine updates
    }

    // Inventory records
    match /inventory/{inventoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Supply transfers (Human officer approvals and dispatches)
    match /transfers/{transferId} {
      allow read: if true;
      allow create: if request.resource.data.quantity > 0;
      allow update: if true;
      allow delete: if false; // Strict audit: cannot delete transfer records
    }

    // Immutable Audit Ledger (Append-only)
    match /audit_ledger/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.eventId != null && request.resource.data.action != null;
      allow update: if false; // Immutable: no modifications allowed
      allow delete: if false; // Immutable: no deletions allowed
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
